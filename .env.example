# ============================================================================
# LOMBA IT RADAR INDONESIA — Konfigurasi Environment (.env)
# ============================================================================

# 1. Konfigurasi Telegram Bot (Wajib untuk pengiriman ke Telegram)
# Buat bot di @BotFather untuk mendapatkan TELEGRAM_BOT_TOKEN
# Cek ID chat Anda di @userinfobot untuk mendapatkan TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Interval Pemindaian (dalam menit, khusus mode --daemon 24 jam)
SCAN_INTERVAL_MINUTES=15

# 3. Batas waktu maksimum usia berita/postingan (dalam hari) agar tidak mengambil info basi
MAX_AGE_DAYS=30

# 4. Path Database SQLite untuk menyimpan histori lomba yang sudah dikirim (anti-duplikat)
DB_PATH=data/radar_history.db

# 5. Konfigurasi Network & Rate Limiting
REQUEST_TIMEOUT_SECONDS=12
MAX_REQUESTS_PER_SECOND=3.0
HTTP_PROXY=
